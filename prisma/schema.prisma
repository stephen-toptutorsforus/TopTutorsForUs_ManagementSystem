// TopTutorsForUs — operations platform.
//
// Ported from the SQLAlchemy models in `toptutorsforus_service`. Table and
// column names are deliberately identical to that schema: while the port is in
// progress the Python service is the oracle, and a diff between the two
// databases is only meaningful if the names line up. It also leaves the door
// open to moving data across rather than re-seeding.
//
// Three things Prisma cannot express, added by hand in the migration SQL:
//
//   1. The two GiST EXCLUDE constraints that make instructor and room
//      double-booking impossible. These are where the guarantee actually
//      lives — a check in application code leaves a race window open between
//      the check and the insert.
//   2. The append-only rules on `audit_event`.
//   3. The two partial unique indexes (an email may be null; an unbounded role
//      is held once).
//
// See prisma/migrations/*/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enumerations -----------------------------------------------------------
//
// Native Postgres enums rather than free strings: an invalid status becomes an
// error at the moment of the bad write, not a mystery row found by a report
// months later. Member names are TypeScript-idiomatic; the stored values are
// the lowercase ones the URLs and the JSON API already use, so a link like
// `?status=scheduled` keeps working and the two services agree on the wire.

enum Role {
  ADMIN          @map("admin")
  SCHOOL_ADMIN   @map("school_admin")
  PRINCIPAL      @map("principal")
  REGIONAL_ADMIN @map("regional_admin")
  INSTRUCTOR     @map("instructor")
  STUDENT        @map("student")
  PARENT         @map("parent")
  PAYER          @map("payer")

  @@map("role")
}

enum GuardianRelationship {
  COACH    @map("coach")
  OBSERVER @map("observer")
  PARENT   @map("parent")
  TEACHER  @map("teacher")

  @@map("guardian_relationship")
}

enum UserStatus {
  INVITED        @map("invited")
  PENDING_INVITE @map("pending_invite")
  ACTIVE         @map("active")
  BOUNCED        @map("bounced")
  DISABLED       @map("disabled")

  @@map("user_status")
}

enum DeliveryType {
  ADVANCED_CLASSROOM @map("advanced_classroom")
  EXTERNAL_LINK      @map("external_link")
  IN_PERSON          @map("in_person")

  @@map("delivery_type")
}

enum SessionStatus {
  REQUESTED   @map("requested")
  REJECTED    @map("rejected")
  SCHEDULED   @map("scheduled")
  RESCHEDULED @map("rescheduled")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")
  MISSED      @map("missed")

  @@map("session_status")
}

enum RecurrenceFrequency {
  DAILY  @map("daily")
  WEEKLY @map("weekly")

  @@map("recurrence_frequency")
}

enum RecurrenceEndMode {
  COUNT @map("count")
  UNTIL @map("until")

  @@map("recurrence_end_mode")
}

enum ParticipantRole {
  INSTRUCTOR @map("instructor")
  STUDENT    @map("student")
  OBSERVER   @map("observer")

  @@map("participant_role")
}

enum AttendanceStatus {
  UNMARKED   @map("unmarked")
  PRESENT    @map("present")
  LATE       @map("late")
  LEFT_EARLY @map("left_early")
  INCOMPLETE @map("incomplete")
  ABSENT     @map("absent")
  EXCUSED    @map("excused")

  @@map("attendance_status")
}

enum AttendanceSource {
  MANUAL    @map("manual")
  BULK      @map("bulk")
  CLASSROOM @map("classroom")
  SYSTEM    @map("system")

  @@map("attendance_source")
}

enum AuditCategory {
  SESSION      @map("session")
  SERIES       @map("series")
  ATTENDANCE   @map("attendance")
  USER         @map("user")
  PERMISSION   @map("permission")
  AVAILABILITY @map("availability")
  CREDIT       @map("credit")
  EXPORT       @map("export")
  IMPORT       @map("import")

  @@map("audit_category")
}

/// Whether an import has only been looked at, or actually written.
///
/// A preview is a real row rather than a scratch variable: it holds the
/// uploaded text between the two requests, and it is what the second request
/// names when it commits. Nothing about what a preview reported can differ from
/// what a commit writes, because both read the same stored bytes.
enum ImportStatus {
  PREVIEWED @map("previewed")
  COMMITTED @map("committed")

  @@map("import_status")
}

enum ImportKind {
  PERSON  @map("person")
  SESSION @map("session")
  SERIES  @map("series")

  @@map("import_kind")
}

// --- Tenant root ------------------------------------------------------------

model Organization {
  id           BigInt    @id @default(autoincrement())
  ref          String    @unique @db.VarChar(24)
  name         String    @db.VarChar(160)
  slug         String    @unique @db.VarChar(64)
  country      String    @default("US") @db.VarChar(2)
  timezone     String    @default("UTC") @db.VarChar(64)
  currency     String    @default("USD") @db.VarChar(3)
  logoUrl      String?   @map("logo_url") @db.VarChar(500)
  supportEmail String?   @map("support_email") @db.VarChar(320)
  supportPhone String?   @map("support_phone") @db.VarChar(32)
  features     Json      @db.JsonB
  settings     Json      @db.JsonB
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  availability           OrganizationAvailability[]
  offDays                OffDay[]
  users                  User[]
  userRoles              UserRole[]
  guardianStudents       GuardianStudent[]
  instructorStudents     InstructorStudent[]
  payerAssignments       PayerAssignment[]
  regions                Region[]
  districts              District[]
  schools                School[]
  programs               Program[]
  subjects               Subject[]
  subjectSpecs           SubjectSpecification[]
  grades                 Grade[]
  locations              Location[]
  groups                 Group[]
  groupMembers           GroupMember[]
  userPrograms           UserProgram[]
  userSchools            UserSchool[]
  userDistricts          UserDistrict[]
  userRegions            UserRegion[]
  instructorSubjects     InstructorSubject[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  timeOff                TimeOff[]
  series                 SessionSeries[]
  sessions               SessionOccurrence[]
  participants           SessionParticipant[]
  auditEvents            AuditEvent[]
  importBatches          ImportBatch[]
  importRecords          ImportRecord[]
  capturedMessages       CapturedMessage[]

  @@map("organization")
}

/// Organization-wide opening hours — the outer bound on every booking.
/// Instructor availability narrows this; it can never widen it.
model OrganizationAvailability {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  weekday        String   @db.VarChar(3)
  startTime      DateTime @map("start_time") @db.Time(6)
  endTime        DateTime @map("end_time") @db.Time(6)
  isOpen         Boolean  @default(true) @map("is_open")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("organization_availability")
}

/// A closure. Organization-wide when `schoolId` is null, otherwise per school.
model OffDay {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  schoolId       BigInt?  @map("school_id")
  day            DateTime @db.Date
  label          String   @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  school       School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([schoolId])
  @@map("off_day")
}

// --- People -----------------------------------------------------------------

/// A person. Email is unique *within* an organization, not globally, so the same
/// person can hold accounts at two tenants without either seeing the other.
/// That uniqueness is a partial index over the rows that have an address —
/// added by hand in the migration, since a student created by a guardian has no
/// address until the guardian sets one.
model User {
  id             BigInt     @id @default(autoincrement())
  ref            String     @unique @db.VarChar(24)
  organizationId BigInt     @map("organization_id")
  email          String?    @db.VarChar(320)
  firstName      String     @map("first_name") @db.VarChar(80)
  lastName       String     @map("last_name") @db.VarChar(80)
  phone          String?    @db.VarChar(32)
  /// Argon2id. Null for somebody invited who has never set one.
  passwordHash   String?    @map("password_hash") @db.VarChar(255)
  status         UserStatus @default(INVITED)
  timezone       String?    @db.VarChar(64)
  grade          String?    @db.VarChar(32)
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Credits a student may spend on a request. Not money, and not a payment.
  creditBalance  Int        @default(0) @map("credit_balance")
  archivedAt     DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  roles                  UserRole[]
  guardianOf             GuardianStudent[]       @relation("GuardianLink")
  guardedBy              GuardianStudent[]       @relation("StudentGuardians")
  teaches                InstructorStudent[]     @relation("InstructorLink")
  taughtBy               InstructorStudent[]     @relation("StudentInstructors")
  paysFor                PayerAssignment[]       @relation("PayerLink")
  paidFor                PayerAssignment[]       @relation("StudentPayers")
  programs               UserProgram[]
  schools                UserSchool[]
  districts              UserDistrict[]
  regions                UserRegion[]
  subjectsTaught         InstructorSubject[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  timeOff                TimeOff[]
  groupMemberships       GroupMember[]

  seriesDefaultFor   SessionSeries[]      @relation("SeriesDefaultInstructor")
  seriesCreated      SessionSeries[]      @relation("SeriesCreatedBy")
  sessionsInstructed SessionOccurrence[]  @relation("SessionInstructor")
  sessionsCreated    SessionOccurrence[]  @relation("SessionCreatedBy")
  sessionsCancelled  SessionOccurrence[]  @relation("SessionCancelledBy")
  participations     SessionParticipant[] @relation("ParticipantUser")
  attendanceMarked   SessionParticipant[] @relation("AttendanceMarkedBy")
  importsStarted     ImportBatch[]        @relation("ImportCreatedBy")
  capturedMessages   CapturedMessage[]

  @@index([organizationId])
  @@index([organizationId, status], map: "ix_user_org_status")
  @@map("user_account")
}

/// One role grant. Roles are rows, not a column: the product requires several
/// per person — a parent who also tutors, an admin who instructs — and a single
/// column forces a duplicate account that splits their history.
/// A regional administrator's scope rides on the grant.
model UserRole {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  userId         BigInt   @map("user_id")
  role           Role
  regionId       BigInt?  @map("region_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  region       Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@unique([userId, role, regionId], map: "uq_user_role")
  @@index([organizationId])
  @@index([userId])
  @@map("user_role")
}

/// Guardian-to-student, many-to-many: several children, several guardians.
model GuardianStudent {
  id               BigInt               @id @default(autoincrement())
  organizationId   BigInt               @map("organization_id")
  guardianId       BigInt               @map("guardian_id")
  studentId        BigInt               @map("student_id")
  isPrimary        Boolean              @default(false) @map("is_primary")
  relationshipKind GuardianRelationship @default(PARENT) @map("relationship")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  guardian     User         @relation("GuardianLink", fields: [guardianId], references: [id], onDelete: Cascade)
  student      User         @relation("StudentGuardians", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId], map: "uq_guardian_student")
  @@index([organizationId])
  @@index([guardianId])
  @@index([studentId])
  @@map("guardian_student")
}

/// An assignment. Under `assigned_users_only` this table is the eligibility list
/// for booking, in both directions.
model InstructorStudent {
  id             BigInt    @id @default(autoincrement())
  organizationId BigInt    @map("organization_id")
  instructorId   BigInt    @map("instructor_id")
  studentId      BigInt    @map("student_id")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instructor   User         @relation("InstructorLink", fields: [instructorId], references: [id], onDelete: Cascade)
  student      User         @relation("StudentInstructors", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([instructorId, studentId], map: "uq_instructor_student")
  @@index([organizationId])
  @@index([instructorId])
  @@index([studentId])
  @@map("instructor_student")
}

/// Who pays for a student. Modelled now so credits and invoicing later attach to
/// a relationship that already exists rather than inventing one.
model PayerAssignment {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  payerId        BigInt   @map("payer_id")
  studentId      BigInt   @map("student_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payer        User         @relation("PayerLink", fields: [payerId], references: [id], onDelete: Cascade)
  student      User         @relation("StudentPayers", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([payerId, studentId], map: "uq_payer_student")
  @@index([organizationId])
  @@index([payerId])
  @@index([studentId])
  @@map("payer_assignment")
}

// --- Structure --------------------------------------------------------------
//
// The vocabulary a tenant books against. Every table is tenant-owned and
// tenant-configured; nothing ships with a customer's programs or grade names
// baked in. Uniqueness is always scoped to the organization, so two tenants may
// both have a program named "Reading Support" without colliding.

model Region {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  name           String    @db.VarChar(120)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  districts    District[]
  programs     Program[]
  userRoles    UserRole[]
  userRegions  UserRegion[]

  @@unique([organizationId, name], map: "uq_region_org_name")
  @@index([organizationId])
  @@map("region")
}

model District {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  regionId       BigInt?   @map("region_id")
  name           String    @db.VarChar(120)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  region        Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  schools       School[]
  userDistricts UserDistrict[]

  @@unique([organizationId, name], map: "uq_district_org_name")
  @@index([organizationId])
  @@index([regionId])
  @@map("district")
}

model School {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  districtId     BigInt?   @map("district_id")
  name           String    @db.VarChar(160)
  timezone       String?   @db.VarChar(64)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  district     District?    @relation(fields: [districtId], references: [id], onDelete: SetNull)
  locations    Location[]
  offDays      OffDay[]
  userSchools  UserSchool[]

  @@unique([organizationId, name], map: "uq_school_org_name")
  @@index([organizationId])
  @@index([districtId])
  @@map("school")
}

model Program {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  regionId       BigInt?   @map("region_id")
  name           String    @db.VarChar(160)
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  region       Region?             @relation(fields: [regionId], references: [id], onDelete: SetNull)
  groups       Group[]
  userPrograms UserProgram[]
  series       SessionSeries[]
  sessions     SessionOccurrence[]

  @@unique([organizationId, name], map: "uq_program_org_name")
  @@index([organizationId])
  @@index([regionId])
  @@map("program")
}

model Subject {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  name           String    @db.VarChar(120)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  specifications     SubjectSpecification[]
  instructorSubjects InstructorSubject[]
  series             SessionSeries[]
  sessions           SessionOccurrence[]

  @@unique([organizationId, name], map: "uq_subject_org_name")
  @@index([organizationId])
  @@map("subject")
}

model SubjectSpecification {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  subjectId      BigInt    @map("subject_id")
  name           String    @db.VarChar(120)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name], map: "uq_subject_spec_name")
  @@index([organizationId])
  @@index([subjectId])
  @@map("subject_specification")
}

/// Grade labels are tenant vocabulary — "Year 7" and "7th Grade" are both valid
/// and neither is hard-coded. `sortOrder` keeps them in curriculum order rather
/// than alphabetical.
model Grade {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  name           String    @db.VarChar(64)
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instructorSubjects InstructorSubject[]
  series             SessionSeries[]
  sessions           SessionOccurrence[]

  @@unique([organizationId, name], map: "uq_grade_org_name")
  @@index([organizationId])
  @@map("grade")
}

/// A physical place an in-person session can occupy. Bookable exactly once at a
/// time — room double-booking is one of the four conflict checks, and the one
/// the database refuses outright.
model Location {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  schoolId       BigInt?   @map("school_id")
  name           String    @db.VarChar(160)
  address        String?
  capacity       Int?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  school       School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  series       SessionSeries[]
  sessions     SessionOccurrence[]

  @@unique([organizationId, name], map: "uq_location_org_name")
  @@index([organizationId])
  @@index([schoolId])
  @@map("location")
}

/// A named cohort. Booking a group expands it to its members at booking time and
/// materialises them as participants, so a later membership change does not
/// silently rewrite the attendance denominator of a session already held.
model Group {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  programId      BigInt?   @map("program_id")
  name           String    @db.VarChar(160)
  capacity       Int?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  members      GroupMember[]
  series       SessionSeries[]
  sessions     SessionOccurrence[]

  @@unique([organizationId, name], map: "uq_group_org_name")
  @@index([organizationId])
  @@index([programId])
  @@map("student_group")
}

model GroupMember {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  groupId        BigInt   @map("group_id")
  userId         BigInt   @map("user_id")
  memberRole     String   @default("student") @map("member_role") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, memberRole], map: "uq_group_member")
  @@index([organizationId])
  @@index([groupId])
  @@index([userId])
  @@map("group_member")
}

model UserProgram {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  userId         BigInt   @map("user_id")
  programId      BigInt   @map("program_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId], map: "uq_user_program")
  @@index([organizationId])
  @@index([userId])
  @@index([programId])
  @@map("user_program")
}

model UserSchool {
