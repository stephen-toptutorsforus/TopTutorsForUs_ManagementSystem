// --- Availability -----------------------------------------------------------
//
// Expressed in wall-clock time plus an IANA zone, never as instants.
// "Tuesdays 16:00-18:00 in Europe/Lisbon" is a stable statement; the same rule
// stored as UTC instants drifts by an hour twice a year and quietly starts
// refusing legitimate bookings after a DST change.
//
// Three layers, resolved narrowest last: the weekly rule, a dated exception
// that replaces or removes it, and time off that blocks whatever it covers.

model AvailabilityRule {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  instructorId   BigInt    @map("instructor_id")
  weekday        String    @db.VarChar(3)
  startTime      DateTime  @map("start_time") @db.Time(6)
  endTime        DateTime  @map("end_time") @db.Time(6)
  /// The zone the wall-clock times are stated in; falls back to the
  /// organization's when null.
  timezone       String?   @db.VarChar(64)
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instructor   User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, weekday, startTime, endTime], map: "uq_availability_rule")
  @@index([organizationId])
  @@index([instructorId])
  @@index([organizationId, instructorId, weekday], map: "ix_availability_rule_instructor")
  @@map("availability_rule")
}

/// A single date that overrides the weekly pattern. `isAvailable = false` with
/// no times removes the day entirely; with times it replaces that day's windows
/// — the usual "I can only do mornings this Friday".
model AvailabilityException {
  id             BigInt    @id @default(autoincrement())
  ref            String    @unique @db.VarChar(24)
  organizationId BigInt    @map("organization_id")
  instructorId   BigInt    @map("instructor_id")
  day            DateTime  @db.Date
  isAvailable    Boolean   @default(false) @map("is_available")
  startTime      DateTime? @map("start_time") @db.Time(6)
  endTime        DateTime? @map("end_time") @db.Time(6)
  timezone       String?   @db.VarChar(64)
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instructor   User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([instructorId])
  @@index([organizationId, instructorId, day], map: "ix_availability_exception_day")
  @@map("availability_exception")
}

/// A blocked instant range. Unlike the rules above this is stored in UTC,
/// because "away from 14:00 on the 3rd until 09:00 on the 8th" is a span of real
/// time, not a repeating wall-clock statement.
model TimeOff {
  id             BigInt   @id @default(autoincrement())
  ref            String   @unique @db.VarChar(24)
  organizationId BigInt   @map("organization_id")
  instructorId   BigInt   @map("instructor_id")
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  reason         String?  @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instructor   User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([instructorId])
  @@index([organizationId, instructorId, startsAt, endsAt], map: "ix_time_off_range")
  @@map("time_off")
}

// --- Sessions ---------------------------------------------------------------
//
// Occurrences are materialised rows, not computed on read. A virtual series
// would force the calendar, the grid, exports, attendance and billing each to
// grow its own expander, and they would drift. Materialising them means one
// occurrence can be edited, cancelled or rescheduled without the series knowing
// — which is the behaviour the product requires.

/// The recurrence rule and the defaults its occurrences are generated from. The
/// series holds *defaults*: once generated, an occurrence's own columns are
/// authoritative and the series is not a live template it reads through.
model SessionSeries {
  id                     BigInt              @id @default(autoincrement())
  ref                    String              @unique @db.VarChar(24)
  organizationId         BigInt              @map("organization_id")
  title                  String              @db.VarChar(200)
  description            String?
  deliveryType           DeliveryType        @map("delivery_type")
  defaultDurationMinutes Int                 @map("default_duration_minutes")
  /// The zone the recurrence walks its civil dates in. Never derived at read
  /// time — a series booked in one zone keeps its wall-clock time for ever.
  timezone               String              @db.VarChar(64)
  frequency              RecurrenceFrequency
  intervalN              Int                 @default(1) @map("interval_n")
  /// ISO weekday names for a weekly rule, e.g. ["mon", "wed"].
  weekdays               Json                @db.JsonB
  startDate              DateTime            @map("start_date") @db.Date
  startTime              DateTime            @map("start_time") @db.Time(6)
  endMode                RecurrenceEndMode   @map("end_mode")
  occurrenceCount        Int?                @map("occurrence_count")
  untilDate              DateTime?           @map("until_date") @db.Date
  defaultInstructorId    BigInt?             @map("default_instructor_id")
  groupId                BigInt?             @map("group_id")
  programId              BigInt?             @map("program_id")
  subjectId              BigInt?             @map("subject_id")
  gradeId                BigInt?             @map("grade_id")
  locationId             BigInt?             @map("location_id")
  /// Free text, and deliberately not a substitute for `locationId`: only the
  /// foreign key can carry the room exclusion constraint, because two people
  /// typing the same building differently are not the same room to a database.
  locationDetail         String?             @map("location_detail") @db.VarChar(500)
  meetingUrl             String?             @map("meeting_url") @db.VarChar(1000)
  billable               Boolean             @default(true)
  classroomConfig        Json                @map("classroom_config") @db.JsonB
  createdById            BigInt?             @map("created_by_id")
  archivedAt             DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultInstructor User?        @relation("SeriesDefaultInstructor", fields: [defaultInstructorId], references: [id], onDelete: SetNull)
  group             Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  program           Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  subject           Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  grade             Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  location          Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy         User?        @relation("SeriesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  occurrences SessionOccurrence[]

  @@index([organizationId])
  @@index([organizationId, createdAt], map: "ix_series_org_created")
  @@index([defaultInstructorId])
  @@map("session_series")
}

/// A single bookable session. Stands alone when `seriesId` is null.
///
/// It owns its own schedule: `scheduledStart` and `scheduledEnd` are columns
/// here, not derived from the series rule, so editing one cannot touch another.
/// `detachedFromSeries` records that a later series-wide edit must skip it.
///
/// Scheduled time and actual time are different facts. Reports need both, and
/// overwriting one with the other destroys the comparison the product exists to
/// show.
model SessionOccurrence {
  id                 BigInt        @id @default(autoincrement())
  ref                String        @unique @db.VarChar(24)
  organizationId     BigInt        @map("organization_id")
  seriesId           BigInt?       @map("series_id")
  /// Position within the series, 1-based, so the interface can say "3 of 12"
  /// without counting rows or leaking a database id.
  seriesIndex        Int?          @map("series_index")
  detachedFromSeries Boolean       @default(false) @map("detached_from_series")
  title              String        @db.VarChar(200)
  description        String?
  deliveryType       DeliveryType  @map("delivery_type")
  meetingUrl         String?       @map("meeting_url") @db.VarChar(1000)
  /// Provider metadata for an auto-created meeting — meeting id and the host
  /// start URL. The student join link stays in `meetingUrl`. The series row
  /// already had this column; the occurrence owns its own meeting, so the
  /// config has to live here too. Never a `zoom_*` column: those names are
  /// not in the reference schema.
  classroomConfig    Json          @default("{}") @map("classroom_config") @db.JsonB
  locationId         BigInt?       @map("location_id")
  locationDetail     String?       @map("location_detail") @db.VarChar(500)
  scheduledStart     DateTime      @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd       DateTime      @map("scheduled_end") @db.Timestamptz(6)
  actualStart        DateTime?     @map("actual_start") @db.Timestamptz(6)
  actualEnd          DateTime?     @map("actual_end") @db.Timestamptz(6)
  /// An occurrence keeps the zone it was booked in even if the organization
  /// later changes its own.
  timezone           String        @db.VarChar(64)
  status             SessionStatus @default(SCHEDULED)
  instructorId       BigInt?       @map("instructor_id")
  groupId            BigInt?       @map("group_id")
  programId          BigInt?       @map("program_id")
  subjectId          BigInt?       @map("subject_id")
  gradeId            BigInt?       @map("grade_id")
  billable           Boolean       @default(true)
  /// Carried now so the grid columns the product requires exist from the start
  /// rather than being bolted on. Nothing writes them yet.
  paymentState       String        @default("unpaid") @map("payment_state") @db.VarChar(24)
  invoiceRef         String?       @map("invoice_ref") @db.VarChar(24)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(64)
  cancellationNote   String?       @map("cancellation_note")
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      BigInt?       @map("cancelled_by_id")
  missedReason       String?       @map("missed_reason") @db.VarChar(64)
  rescheduleReason   String?       @map("reschedule_reason")
  /// True when an authorised administrator booked over a detected conflict. The
  /// override is also written to the audit trail; this column makes it
  /// filterable.
  conflictOverridden Boolean       @default(false) @map("conflict_overridden")
  createdById        BigInt?       @map("created_by_id")
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  series       SessionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  instructor   User?          @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  group        Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  program      Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  subject      Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  grade        Grade?         @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  cancelledBy  User?          @relation("SessionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  participants     SessionParticipant[]
  capturedMessages CapturedMessage[]

  @@unique([seriesId, seriesIndex], map: "uq_session_series_index")
  @@index([organizationId])
  @@index([organizationId, scheduledStart, scheduledEnd], map: "ix_session_org_window")
  @@index([organizationId, status], map: "ix_session_org_status")
  @@index([seriesId, seriesIndex], map: "ix_session_series_index")
  @@index([seriesId])
  @@index([instructorId])
  @@index([locationId])
  @@index([programId])
  @@map("session_occurrence")
}

/// One person's place in one session, and their attendance record.
///
/// Rows are created at booking time for the whole expected roster, so the
/// attendance denominator is "everyone who was expected", not "whoever turned
/// up". A student added to a group next month does not retroactively appear in
/// last month's session.
model SessionParticipant {
  id              BigInt            @id @default(autoincrement())
  organizationId  BigInt            @map("organization_id")
  sessionId       BigInt            @map("session_id")
  userId          BigInt            @map("user_id")
  role            ParticipantRole
  attendance      AttendanceStatus  @default(UNMARKED)
  joinedAt        DateTime?         @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime?         @map("left_at") @db.Timestamptz(6)
  /// Recorded rather than derived from joined/left, because a participant may
  /// join and leave several times and the total is what matters.
  attendedMinutes Int?              @map("attended_minutes")
  markedById      BigInt?           @map("marked_by_id")
  markedAt        DateTime?         @map("marked_at") @db.Timestamptz(6)
  markedSource    AttendanceSource? @map("marked_source")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session      SessionOccurrence @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User              @relation("ParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  markedBy     User?             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId, role], map: "uq_session_participant")
  @@index([organizationId])
  @@index([sessionId])
  @@index([userId])
  @@index([organizationId, userId, sessionId], map: "ix_participant_user_session")
  @@map("session_participant")
}

// --- Audit ------------------------------------------------------------------

/// One recorded change. No `updatedAt`: these rows never change, and the
/// migration adds rules that make UPDATE and DELETE do nothing at all.
///
/// `changes` holds `{"field": {"from": ..., "to": ...}}` for scheduling and
/// status fields and nothing else. Note bodies, message text, addresses and
/// meeting URLs never enter it — an audit trail that becomes a second,
/// less-protected copy of the data it exists to protect is worse than none.
/// A message this product would have sent, kept here instead of leaving the building.
///
/// No email provider and no SMS provider. The address is the person's own
/// `.test` address or phone, and the body never carries a meeting link.
model CapturedMessage {
  id             BigInt    @id @default(autoincrement())
  organizationId BigInt    @map("organization_id")
  sessionId      BigInt?   @map("session_id")
  userId         BigInt    @map("user_id")
  channel        String    @db.VarChar(16)
  kind           String    @db.VarChar(32)
  offsetMinutes  Int       @default(0) @map("offset_minutes")
  address        String    @db.VarChar(320)
  body           String    @db.VarChar(500)
  dueAt          DateTime  @map("due_at") @db.Timestamptz(6)
  retiredAt      DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session      SessionOccurrence? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt], map: "ix_captured_message_org")
  @@index([sessionId], map: "ix_captured_message_session")
  @@map("captured_message")
}

model AuditEvent {
  id             BigInt        @id @default(autoincrement())
  ref            String        @unique @db.VarChar(24)
  organizationId BigInt        @map("organization_id")
  category       AuditCategory
  /// A verb phrase in the domain's own words, e.g. "session.rescheduled".
  action         String        @db.VarChar(64)
  entityType     String        @map("entity_type") @db.VarChar(48)
  entityId       BigInt        @map("entity_id")
  /// The public ref of the entity, so a viewer never has to see a database id.
  entityRef      String?       @map("entity_ref") @db.VarChar(24)
  /// Deliberately *not* a foreign key. An audit event is a historical fact, and
  /// a referential action that rewrites an append-only row is a contradiction —
  /// one that made anybody who had ever acted undeletable.
  actorId        BigInt?       @map("actor_id")
  /// Copied, not joined: the trail must still read correctly after the actor's
  /// roles change or their account is archived.
  actorRole      String?       @map("actor_role") @db.VarChar(32)
  actorLabel     String?       @map("actor_label") @db.VarChar(160)
  changes        Json          @db.JsonB
  /// A short, non-identifying explanation, e.g. "conflict override".
  note           String?       @db.VarChar(240)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.VarChar(240)
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId, occurredAt], map: "ix_audit_subject")
  @@index([organizationId, actorId, occurredAt], map: "ix_audit_actor")
  @@index([actorId])
  @@map("audit_event")
}

// --- Import -----------------------------------------------------------------

/// One run of the import screen.
///
/// It exists for three reasons, and the first is the one that made it
/// necessary. **A Pearl export carries no identifier of any kind** — not for a
/// person, not for a session, not for a series — so "have I already imported
/// this row" cannot be answered from the file. It is answered from here
/// instead: every row written records the key it came from, and a second run
/// matches rather than duplicates.
///
/// Second, it holds the uploaded text between the preview and the confirmation,
/// so what somebody is shown is by construction what gets written — the rule
/// `plan()` and `createFromPlan()` already follow for booking.
///
/// Third, it is the answer to "what did that import do", months later, from a
/// report that names counts and reasons and never a person.
///
/// The source columns are cleared on commit. By then the rows are written, and
/// a second copy of somebody's children sitting in a staging column is a
/// liability with nothing left to justify it.
model ImportBatch {
  id             BigInt       @id @default(autoincrement())
  ref            String       @unique @db.VarChar(24)
  organizationId BigInt       @map("organization_id")
  createdById    BigInt?      @map("created_by_id")
  status         ImportStatus
  /// SHA-256 of each uploaded file, so an exact re-upload is recognisable even
  /// before a single row is read.
  peopleDigest   String?      @map("people_digest") @db.VarChar(64)
  sessionsDigest String?      @map("sessions_digest") @db.VarChar(64)
  seriesDigest   String?      @map("series_digest") @db.VarChar(64)
  sourcePeople   String?      @map("source_people")
  sourceSessions String?      @map("source_sessions")
  sourceSeries   String?      @map("source_series")
  /// Counts and reasons. Never a name, an address or a row.
  report         Json         @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt    DateTime?    @map("committed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  records      ImportRecord[]

  @@index([organizationId, createdAt], map: "ix_import_batch_org_created")
  @@index([createdById])
  @@map("import_batch")
}

/// What one imported row became.
///
/// `sourceKey` is derived from the row's own content, because the export gives
/// nothing else to derive it from — and for sessions it includes the row's
/// ordinal within the group of rows it is indistinguishable from, since 1,198
/// of one real export's 2,229 sessions share their instructor, start and title
/// with another row. That ordinal is the whole of what makes a second import of
/// the same file match rather than duplicate.
///
/// `entityId` is deliberately not a foreign key. These rows outlive what they
/// point at — a session deleted after an import should not take the record of
/// the import with it, and a referential action would either do that or block
/// the delete.
model ImportRecord {
  id             BigInt     @id @default(autoincrement())
  organizationId BigInt     @map("organization_id")
  batchId        BigInt     @map("batch_id")
  kind           ImportKind
  sourceKey      String     @map("source_key") @db.VarChar(64)
  entityId       BigInt     @map("entity_id")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batch        ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, sourceKey], map: "uq_import_record")
  @@index([batchId])
  @@map("import_record")
}

// --- Shared session slice ---------------------------------------------------
//
// A copy of the school app's session tables, so a change can be stored here
// and sent onward with the same columns and the same string ids. These rows
// are not the booking record: `session_occurrence` stays that. Passwords and
// the host start URL are not columns here.

enum SharedRole {
  STUDENT
  TUTOR
  ADMIN
  SUPER_ADMIN
  PRINCIPAL
  PARENT

  @@map("shared_role")
}

enum SharedSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED

  @@map("shared_session_status")
}

enum SharedAttendanceStatus {
  UNMARKED
  PRESENT
  LATE
  ABSENT

  @@map("shared_attendance_status")
}

model SharedSchool {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  timezone String @default("America/Chicago")

  users SharedUser[]

  @@map("shared_school")
}

model SharedUser {
  id       String        @id @default(cuid())
  email    String        @unique
  name     String
  role     SharedRole
  schoolId String?
  school   SharedSchool? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  tutoredPods     SharedPod[]               @relation("SharedPodTutor")
  podMemberships  SharedPodMembership[]     @relation("SharedPodStudent")
  tutoredSessions SharedSession[]           @relation("SharedSessionTutor")
  attendance      SharedSessionAttendance[] @relation("SharedAttendanceStudent")

  @@index([schoolId])
  @@map("shared_user")
}

model SharedPod {
  id        String     @id @default(cuid())
  name      String
  subject   String
  tutorId   String
  tutor     SharedUser @relation("SharedPodTutor", fields: [tutorId], references: [id])
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())

  members  SharedPodMembership[]
  sessions SharedSession[]

  @@index([tutorId])
  @@map("shared_pod")
}

model SharedPodMembership {
  id        String     @id @default(cuid())
  podId     String
  pod       SharedPod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  studentId String
  student   SharedUser @relation("SharedPodStudent", fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime   @default(now())
  status    String     @default("ACTIVE")

  @@unique([podId, studentId])
  @@index([studentId])
  @@map("shared_pod_membership")
}

model SharedSession {
  id          String              @id @default(cuid())
  podId       String
  pod         SharedPod           @relation(fields: [podId], references: [id])
  tutorId     String
  tutor       SharedUser          @relation("SharedSessionTutor", fields: [tutorId], references: [id])
  title       String
  subject     String
  scheduledAt DateTime
  duration    Int                 @default(60)
  status      SharedSessionStatus @default(SCHEDULED)
  /// The student join link. The host start URL is not a column.
  zoomJoinUrl String?

  attendance SharedSessionAttendance[]

  @@index([podId])
  @@index([tutorId])
  @@map("shared_session")
}

model SharedSessionAttendance {
  id        String                 @id @default(cuid())
  sessionId String
  session   SharedSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   SharedUser             @relation("SharedAttendanceStudent", fields: [studentId], references: [id])
  status    SharedAttendanceStatus @default(UNMARKED)
  joinedAt  DateTime?
  leftAt    DateTime?

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("shared_session_attendance")
}

/// Ops row to shared id. Edit and cancel find the copy through this, and the
/// shared tables themselves stay shaped like the school app.
model SharedLink {
  id         BigInt @id @default(autoincrement())
  entityType String @map("entity_type") @db.VarChar(32)
  opsId      BigInt @map("ops_id")
  sharedId   String @map("shared_id")

  @@unique([entityType, opsId], map: "uq_shared_link")
  @@index([sharedId], map: "ix_shared_link_shared")
  @@map("shared_link")
}

/// One change waiting to be delivered to the other database.
model OutboundChange {
  id        BigInt   @id @default(autoincrement())
  kind      String   @db.VarChar(48)
  sessionId String   @map("session_id")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set once the row has been written into the other database.
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  @@index([createdAt], map: "ix_outbound_change_created")
  @@index([deliveredAt], map: "ix_outbound_change_delivered")
  @@map("outbound_change")
}

/// An inbound change already stored. A second delivery of the same source id
/// does nothing, and storing it does not write an outbound change.
model AppliedInbound {
  id        BigInt   @id @default(autoincrement())
  sourceId  String   @unique @map("source_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("applied_inbound")
}
