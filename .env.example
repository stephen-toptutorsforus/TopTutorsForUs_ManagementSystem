# Copy to `.env` and fill in. Do NOT commit `.env` (it is git-ignored).

APP_ENV=development
LOG_LEVEL=info

# Read-write Postgres for this service's own schema. In production use a
# least-privilege role, never a superuser.
#
# Deliberately NOT `tutorops_dev`: while the port is in progress that database
# belongs to the Python service, which is the reference implementation this one
# is checked against. Pointing here at it would destroy the thing being copied.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tutorops_ops_dev

# Separate database the test suite rebuilds freely.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tutorops_ops_test

# Local stand-in for the main app's database. `npm run sync:local` refuses
# any database name other than toptutorsforus_schools.
# SCHOOL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/toptutorsforus_schools

# Signs session cookies and CSRF tokens. Generate per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=dev-only-insecure-key-change-me

# Session cookie lifetime in seconds (default 12 hours).
SESSION_MAX_AGE=43200

# Zoom (optional). Auto-create on booking when Type is Online.
# Mock is opt-in — missing credentials do not silently become a mock.
# USE_MOCK_ZOOM=true
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=
# ZOOM_HOST_EMAIL=
