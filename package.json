{
  "name": "toptutorsforus-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Tutoring operations: people and roles, instructor availability, standalone and recurring session booking, a calendar, attendance, and an audit trail.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.mts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:scenarios": "tsx prisma/scenarios.ts",
    "db:test-accounts": "tsx tools/make-test-accounts.ts",
    "db:link-schools": "tsx tools/link-local-schools.ts",
    "sync:local": "tsx tools/sync-local.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "bundle": "node scripts/serve.mjs --assemble-only"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "luxon": "^3.7.2",
    "next": "^16.3.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
